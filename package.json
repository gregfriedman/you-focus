{
  "name": "you-focus",
  "version": "0.13",
  "description": "A lightweight productivity Chrome extension that hides distracting recommendations and popups on YouTube",
  "homepage": "https://github.com/leo3friedman/you-focus#readme",
  "bugs": {
    "url": "https://github.com/leo3friedman/you-focus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leo3friedman/you-focus.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "rsync -a --exclude=\"*.js\" --delete src/ dist/ && esbuild src/main.js src/popup.js --bundle --outdir=dist --outbase=src",
    "fixture": "node utils/fixtureUtils/prepareFixture.js",
    "pw:open": "npm run build && playwright test --ui",
    "pw:run": "npm run build && playwright test",
    "pw:update": "npm run build && playwright test --update-snapshots",
    "setup": "npm ci --ignore-scripts && playwright install --with-deps chromium",
    "test": "vitest --project unit",
    "test:integration": "vitest --project integration"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "wallaby": {
    "autoDetect": true,
    "tests": [
      "**/*.test.js"
    ]
  },
  "dependencies": {
    "ramda": "^0.32.0"
  }
}
